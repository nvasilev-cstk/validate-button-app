{
  "name": "Article Validation Trigger",
  "description": "Adds a Validation Trigger button as a custom field. It can run every configured validation category (each against its own endpoint), or auto-trigger a single category when one of its fields is edited, then polls a status lookup URL and displays each category's feedback as it arrives.",
  "icon": "https://www.contentstack.com/favicon.ico",
  "visibility": "private",
  "target_type": "stack",
  "ui_location": {
    "locations": [
      {
        "type": "cs.cm.stack.custom_field",
        "meta": [
          {
            "path": "/index.html",
            "signed": true,
            "enabled": true,
            "name": "Validation Trigger",
            "extension_uid": "",
            "field_data_type": ["text", "json"],
            "multiple": false,
            "config": {
              "statusUrl": "",
              "api_key": "",
              "authorization": "",
              "refresh_rate": 5000,
              "run_at_load": "false",
              "validation_urls": {
                "headline_check": "",
                "url_check": "",
                "author_check": "",
                "featured_image_check": "",
                "seo_check": "",
                "section_and_tag_check": "",
                "article_text_check": ""
              },
              "validation_fields": {
                "headlines": [],
                "urls": [],
                "authors": [],
                "featured_images": [],
                "seos": [],
                "sections_and_tags": [],
                "article_text": []
              },
              "validation_watch_fields": {
                "featured_images": []
              }
            }
          }
        ]
      }
    ]
  },
  "webhook": null,
  "hosting": {
    "type": "launch",
    "launch_uid": ""
  }
}
